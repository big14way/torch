# Torch executor — Railway service variables.
#
# Copy these into Railway -> your executor service -> Variables. The real
# EXECUTOR_PRIVATE_KEY is generated once and kept in agent/.env.railway.local
# (gitignored); everything else here is safe to read.
#
# The one thing that changed when Torch left Phala: this key is supplied, not
# minted at boot. It therefore SURVIVES restarts and redeploys, which is what
# ends the rotate-and-strand cycle. Generate it once, authorize it once
# (npm run set:agent -w contracts), fund it, and leave it alone.

# --- identity -------------------------------------------------------------
# The relaying key. Never minted in-process now, so restarts are free.
EXECUTOR_PRIVATE_KEY=0x_paste_from_env_railway_local

# Railway injects PORT. The agent serves its JSON status on every path and
# answers 503 when the loop stops ticking, which is what the healthcheck reads.
PORT=3000

# --- chain ----------------------------------------------------------------
# enosys first: the public coston2-api endpoint throttles under load and froze
# the executor on Jul 15.
RPC_URL=https://coston2.enosys.global/ext/C/rpc

# --- execution ------------------------------------------------------------
# testnet: venue-listed markets (BTC, ETH, ...) route real Hyperliquid testnet
# orders. XRP is not listed there and falls back to the oracle mark.
EXECUTION_MODE=testnet
HL_API_URL=https://api.hyperliquid-testnet.xyz
# Trade-only API wallet. No withdrawal permission.
HL_PRIVATE_KEY=0x_trade_only_api_wallet

# --- Flare Confidential Compute -------------------------------------------
# The adapter the vault trusts as its executor. The agent reads vault.executor()
# and only routes through this once the vault points at it, so setting it is
# inert until then and rollback needs no redeploy.
TEE_ADAPTER_ADDRESS=0x321f606ed6cd64C2478F18053cFAb4ec1B0261de
# The Flare Compute Extension that signs fill prices (extension 66154).
FCE_ACTION_URL=https://torch-fce-production.up.railway.app/action

# --- receipts -------------------------------------------------------------
# v2-bound consumer: enables the agent's per-fill attestation round trip.
FDC_CONSUMER=0xe3B21cbD82dcc4acD4BFDAC5Ee61AC1E2B9F2a6f

# --- NOT set on Railway ---------------------------------------------------
# ENCLAVE_KEYGEN / DSTACK / IMAGE_DIGEST were Phala-only. Setting ENCLAVE_KEYGEN
# here would mint a throwaway key at every boot and reintroduce exactly the
# failure this migration removes.
